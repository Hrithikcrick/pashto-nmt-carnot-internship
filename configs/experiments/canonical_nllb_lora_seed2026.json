{
    "study": {
        "name": "extended_a_star_pashto_nmt",
        "stage": "multi_seed_confirmation",
        "status": "planned"
    },
    "model": {
        "name": "facebook/nllb-200-distilled-600M",
        "source_language": "pbt_Arab",
        "target_language": "eng_Latn"
    },
    "dataset": {
        "method": "canonical_pilot",
        "train_file": "data\\splits\\pilot_train.csv",
        "validation_file": "data\\splits\\pilot_validation.csv",
        "test_file": "data\\splits\\pilot_test.csv",
        "train_sha256": "1b99d665a86cce68cc7421773ac93560cd8d7de875caea6fad9cffdc1853fa61",
        "validation_sha256": "5b706dfa818f16d5fb44b5f7978705ba37bc74251487dfd5acd0112c035f1f3e",
        "test_sha256": "ed83c08c49add17a6e7f9063aea36c60fb66003445d2935bbc8545a90823f7e6"
    },
    "training": {
        "epochs": 2.0,
        "learning_rate": 0.0002,
        "batch_size": 2,
        "evaluation_batch_size": 2,
        "gradient_accumulation_steps": 4,
        "maximum_sequence_length": 128,
        "logging_steps": 50,
        "save_strategy": "epoch",
        "evaluation_strategy": "epoch",
        "load_best_model_at_end": true,
        "metric_for_best_model": "eval_loss",
        "greater_is_better": false,
        "mixed_precision": "auto",
        "gradient_checkpointing": false
    },
    "lora": {
        "rank": 8,
        "alpha": 16,
        "dropout": 0.05,
        "bias": "none",
        "target_modules": [
            "q_proj",
            "v_proj"
        ],
        "task_type": "SEQ_2_SEQ_LM"
    },
    "generation": {
        "num_beams": 4,
        "maximum_new_tokens": 128,
        "early_stopping": true
    },
    "evaluation": {
        "metrics": [
            "BLEU",
            "chrF++",
            "TER",
            "COMET"
        ],
        "comet_model": "Unbabel/wmt22-comet-da",
        "bootstrap_samples": 5000,
        "confidence_level": 0.95
    },
    "experiment": {
        "id": "canonical_nllb_lora_seed2026",
        "description": "NLLB-200 LoRA training on fixed source-grouped leak-free canonical splits"
    },
    "reproducibility": {
        "seed": 2026,
        "data_seed": 2026,
        "deterministic_algorithms": true,
        "cudnn_deterministic": true,
        "cudnn_benchmark": false
    },
    "output": {
        "model_directory": "models/research/canonical_nllb_lora_seed2026",
        "prediction_file": "outputs/predictions/canonical_nllb_lora_seed2026_predictions.csv",
        "metrics_file": "outputs/metrics/canonical_nllb_lora_seed2026_metrics.json",
        "training_manifest": "reports/training_manifests/canonical_nllb_lora_seed2026.json",
        "training_log": "logs/canonical_nllb_lora_seed2026.log"
    }
}